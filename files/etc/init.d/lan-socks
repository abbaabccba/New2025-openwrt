#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10
start_service() {
    [ "$(uci -q get lan-socks.main.enabled)" = 1 ] || return 0
    if grep -q 'SOCKS_SERVER_ADDRESS' /etc/hev-socks5-tproxy/main.yml; then
        logger -t lan-socks 'Set the SOCKS5 upstream locally before enabling the service'
        return 1
    fi
    /usr/libexec/lan-socks-rules apply || return 1
    procd_open_instance
    procd_set_param command /usr/bin/hev-socks5-tproxy /etc/hev-socks5-tproxy/main.yml
    procd_set_param file /etc/hev-socks5-tproxy/main.yml /etc/config/lan-socks
    procd_set_param respawn
    procd_set_param limits nofile="4096 4096"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    /usr/libexec/lan-socks-rules remove
}
reload_service() {
    stop
    start
}
service_triggers() {
    procd_add_reload_trigger lan-socks
}
